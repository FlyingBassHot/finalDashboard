# 复制为 .env 后填写。.env 已被 .gitignore 忽略，切勿提交。
APP_NAME=Home Hub

# 留空/注释即使用 backend/data/home_hub.db（相对 backend 目录解析）
# DATABASE_URL=sqlite+aiosqlite:///./data/home_hub.db

# 天气轮询间隔（分钟）
WEATHER_UPDATE_INTERVAL_MINUTES=10

# 状态历史 / 邻居关系保留天数（默认 7 天）
HISTORY_RETENTION_DAYS=7
# 过期数据清理间隔（分钟）
HISTORY_CLEANUP_INTERVAL_MINUTES=360
# 拓扑只展示最近多少秒内上报过的邻居
TOPOLOGY_ACTIVE_WINDOW_SECONDS=600

# Alertmanager webhook 共享令牌（留空则不校验，仅建议内网使用）
ALERT_WEBHOOK_TOKEN=

# 高德 Web 服务 Key：仅用于行政区搜索（GET /api/settings/locations）
# 未配置时该接口返回 503，其余功能不受影响
AMAP_WEB_SERVICE_KEY=

# 允许跨域的来源，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
